# ============================================================
# Deeb Life OS — Environment Variables
# Copy this file to .env and fill in your real values
# ============================================================

# ── Telegram ─────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat ID
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Anthropic (Claude API) ────────────────────────────────────
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Google Calendar ───────────────────────────────────────────
# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
# See setup instructions in README.md
GOOGLE_CREDENTIALS_FILE=google_credentials.json

# Path where the OAuth token will be saved after first auth
GOOGLE_TOKEN_FILE=google_token.json

# Calendar ID — use "primary" for your main calendar
# Or paste a specific calendar ID from Google Calendar settings
GOOGLE_CALENDAR_ID=primary

# ── Timezone ──────────────────────────────────────────────────
# Use a valid IANA timezone string
# Examples: Asia/Riyadh, Asia/Dubai, Europe/London, America/New_York
TIMEZONE=Asia/Riyadh

# ── Schedule Times ────────────────────────────────────────────
MORNING_CHECKIN_HOUR=7
MORNING_CHECKIN_MINUTE=0

EVENING_REVIEW_HOUR=21
EVENING_REVIEW_MINUTE=0

WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=8

# ── Follow-up Settings ────────────────────────────────────────
# Minutes to wait before sending a follow-up if no response
FOLLOWUP_MINUTES=12

# Maximum number of follow-up attempts per context
MAX_FOLLOWUPS=2

# ── Nutrition Targets ─────────────────────────────────────────
MIN_PROTEIN_G=100
TARGET_CALORIES=3000
